<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>WitchKnight</AssemblyName>
    <RootNamespace>WitchKnight</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <Version>0.1.0</Version>
    <Deterministic>true</Deterministic>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <!--
    HollowKnightRefs points at the game's Managed folder with the Modding API installed.
    CI fills ../API with setup-hk. Locally, copy LocalBuildProperties.example.props to
    LocalBuildProperties.props and point it at your install.
  -->
  <Import Project="../LocalBuildProperties.props" Condition="Exists('../LocalBuildProperties.props')" />
  <PropertyGroup>
    <HollowKnightRefs Condition="'$(HollowKnightRefs)' == ''">$(MSBuildThisFileDirectory)../API</HollowKnightRefs>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp" HintPath="$(HollowKnightRefs)/Assembly-CSharp.dll" Private="false" />
    <Reference Include="MMHOOK_Assembly-CSharp" HintPath="$(HollowKnightRefs)/MMHOOK_Assembly-CSharp.dll" Private="false" />
    <Reference Include="MMHOOK_PlayMaker" HintPath="$(HollowKnightRefs)/MMHOOK_PlayMaker.dll" Private="false" />
    <Reference Include="PlayMaker" HintPath="$(HollowKnightRefs)/PlayMaker.dll" Private="false" />
    <Reference Include="UnityEngine" HintPath="$(HollowKnightRefs)/UnityEngine.dll" Private="false" />
    <Reference Include="UnityEngine.CoreModule" HintPath="$(HollowKnightRefs)/UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="UnityEngine.ImageConversionModule" HintPath="$(HollowKnightRefs)/UnityEngine.ImageConversionModule.dll" Private="false" />
    <Reference Include="UnityEngine.Physics2DModule" HintPath="$(HollowKnightRefs)/UnityEngine.Physics2DModule.dll" Private="false" />
    <Reference Include="UnityEngine.IMGUIModule" HintPath="$(HollowKnightRefs)/UnityEngine.IMGUIModule.dll" Private="false" />
    <Reference Include="UnityEngine.InputLegacyModule" HintPath="$(HollowKnightRefs)/UnityEngine.InputLegacyModule.dll" Private="false" />
    <Reference Include="UnityEngine.TextRenderingModule" HintPath="$(HollowKnightRefs)/UnityEngine.TextRenderingModule.dll" Private="false" />
    <Reference Include="InControl" HintPath="$(HollowKnightRefs)/InControl.dll" Private="false" />
    <Reference Include="Newtonsoft.Json" HintPath="$(HollowKnightRefs)/Newtonsoft.Json.dll" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources/Sprites/*.png;Resources/Sprites/anims.json" LogicalName="WitchKnight.Resources.Sprites.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Resources/Enemies/*.png;Resources/Enemies/enemies.json" LogicalName="WitchKnight.Resources.Enemies.%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- Optional: copy the built mod straight into your game's Mods folder. -->
  <Target Name="CopyToMods" AfterTargets="Build" Condition="'$(ModsDir)' != ''">
    <MakeDir Directories="$(ModsDir)/WitchKnight" />
    <Copy SourceFiles="$(TargetPath);$(TargetDir)$(TargetName).pdb" DestinationFolder="$(ModsDir)/WitchKnight" />
  </Target>

</Project>
